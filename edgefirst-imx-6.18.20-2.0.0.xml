  <!-- ================================================================== -->
  <!--  EdgeFirst layers                                                   -->
  <!-- ================================================================== -->

  <project name="meta-edgefirst" remote="edgefirst" path="sources/meta-edgefirst"
           revision="6bbef46030293e569a0175f1dcc1ad4010b8097c" upstream="main" />
  <project name="meta-kinara" remote="edgefirst" path="sources/meta-kinara"
           revision="898eec9059a02cfba5b9d00067bcd5106e0cfda9" upstream="main" />

  <!-- Manifest repo self-reference for tooling.
       NOTE: revision is wrynose-6.18.20 during bring-up;
       flip back to main before merging the upgrade branch. -->
  <project name="yocto" remote="edgefirst" path="sources/edgefirst-yocto" revision="wrynose-6.18.20">
    <linkfile src=".github" dest=".github" />
    <linkfile src="README.md" dest="README.md" />
    <linkfile src="edgefirst-setup" dest="edgefirst-setup" />
  </project>

</manifest>

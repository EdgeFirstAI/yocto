  <project name="meta-arm" path="sources/meta-arm" remote="yocto">
    <ignorebaselayer />
    <sublayer path="meta-arm"/>
    <sublayer path="meta-arm-toolchain"/>
  </project>
  <project name="meta-clang" path="sources/meta-clang" remote="github.clang" revision="003cba92e982bdd565a6889f28799f8bba14957e"/>

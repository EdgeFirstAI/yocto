  <project name="meta-edgefirst" path="sources/meta-edgefirst" remote="edgefirst" revision="289affdc3e8be36db6c26d70bdfce53fb66bc791" upstream="main"/>

  <!-- Manifest repo self-reference for tooling; not a layer -->
  <project name="yocto" path="sources/edgefirst-yocto" remote="edgefirst" revision="edgefirst-phytec-imx8mp-PD26.1.y">
    <ignorebaselayer/>
    <linkfile src="README.md" dest="README-EDGEFIRST.md"/>
  </project>
</manifest>

    <sublayer path="meta-nxp-matter-baseline"/>
    <sublayer path="meta-nxp-openthread"/>
    <sublayer path="meta-nxp-zigbee-rcp"/>
  </project>
  <project name="meta-nxp-demo-experience" path="sources/meta-nxp-demo-experience" remote="github.imx-support" revision="refs/tags/rel_imx_6.12.49_2.2.0" upstream="walnascar-6.12.49-2.2.0"/>

  <project name="meta-hailo-phytec" path="sources/meta-hailo" remote="github.phytec" revision="hailo8-walnascar">
